# Configuration partagée des mocks Pennylane. Copier en .env (facultatif : tout a une valeur par défaut).
# Lu par Docker Compose (docker-compose.yml de ce dossier) et par les scripts npm des deux sous-projets.

# ── api-server : API Company / Firm / Firm group (json-server) ─────────────────────
# Adresse d'écoute hors Docker (Docker force 0.0.0.0)
MOCK_HOST=127.0.0.1
# off : désactive la vérification des jetons statiques (le dossier 101 est utilisé par défaut)
MOCK_AUTH=on

# Adresse de l'endpoint d'introspection du mock OAuth (Docker la fixe à pennylane-oauth-mock)
# OAUTH_INTROSPECTION_URL=http://127.0.0.1:3000/_mock/introspect

# ── oauth-server : serveur OAuth 2.0 et point d'entrée unique ──────────────────────
# Client OAuth de test (l'équivalent de ce que Pennylane fournit à l'enregistrement de l'app)
OAUTH_CLIENT_ID=pennylane-poc
OAUTH_CLIENT_SECRET=pennylane-poc-secret
# Comparaison exacte. Plusieurs URI possibles, séparées par des espaces.
OAUTH_REDIRECT_URI=http://localhost:8000/pennylane/callback
# Scopes que le client peut demander. Vide : tous les scopes des specs Pennylane.
# OAUTH_ALLOWED_SCOPES=customers:readonly customer_invoices:readonly

# Durées de vie en secondes (valeurs Pennylane par défaut : 24 h et 90 jours)
ACCESS_TOKEN_TTL=86400
REFRESH_TOKEN_TTL=7776000
AUTHORIZATION_CODE_TTL=60

# Où trouver l'api-server : machine pour le relais des API (Docker : pennylane-mock), dossier pour ses données
# API_SERVER_HOST=127.0.0.1
# API_SERVER_DIR=../api-server

# Port d'écoute hors Docker, et port publié sur l'hôte par Docker Compose
OAUTH_PORT=3000
OAUTH_MOCK_HOST_PORT=3000
